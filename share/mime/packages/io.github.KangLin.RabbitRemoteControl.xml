<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/rrc">
    <comment>Rabbit Remote Control Session File</comment>
    <comment xml:lang="zh_CN">玉兔远程控制会话文件</comment>
    <comment xml:lang="zh_TW">玉兔遠程控制會話文件</comment>
    <glob pattern="*.rrc"/>
  </mime-type>
</mime-info>

<!--
The file copy to /usr/share/mime/packages
or ~/.local/share/mime/packages
then use follow order to update MimeType
   `update-mime-database ~/.local/share/mime/`

# 1. 确认 MIME 定义文件存在
ls -la ~/.local/share/mime/packages/rrc.xml

# 2. 确认 MIME 数据库已更新
ls -la ~/.local/share/mime/globs2

# 3. 查询 MIME 类型是否存在
xdg-mime query filetype test.rrc
# 应输出：application/rrc
-->
